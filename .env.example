# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой: отправьте боту /myid)
ADMIN_IDS=

# Публичный HTTPS-адрес Mini App (туннель cloudflared при разработке или домен на сервере)
WEBAPP_URL=

# Название бизнеса в приветствии бота и в Mini App
BUSINESS_NAME=Барбершоп «Борода»

# Часовой пояс бизнеса: все записи считаются по нему
BUSINESS_TZ=Europe/Moscow

PORT=3000

# HTTP-прокси для Telegram API, если api.telegram.org недоступен напрямую
# TELEGRAM_PROXY=http://127.0.0.1:10809

# Только для разработки: открыть Mini App в обычном браузере от имени этого пользователя
# DEV_USER_ID=
